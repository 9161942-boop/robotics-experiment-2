<?xml version="1.0"?>
<robot name="mecharm_270_gazebo" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="controllers_file" default="$(find mecharm_fixed_pick_sim)/config/controllers.yaml"/>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${mass * (y * y + z * z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (x * x + z * z) / 12.0}"
        iyz="0.0"
        izz="${mass * (x * x + y * y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="mesh_visual_box_collision_link" params="name mesh visual_xyz visual_rpy sx sy sz ox oy oz mass">
    <link name="${name}">
      <xacro:box_inertial mass="${mass}" x="${sx}" y="${sy}" z="${sz}"/>
      <visual>
        <origin xyz="${visual_xyz}" rpy="${visual_rpy}"/>
        <geometry>
          <mesh filename="${mesh}"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
        <geometry>
          <box size="${sx} ${sy} ${sz}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="controlled_joint" params="name lower upper">
    <joint name="${name}">
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <link name="world"/>

  <link name="base">
    <xacro:box_inertial mass="1.2" x="0.12" y="0.12" z="0.08"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -3.1415926"/>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/base.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.08"/>
      </geometry>
    </collision>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:mesh_visual_box_collision_link
    name="link1"
    mesh="package://mycobot_description/urdf/mecharm_270_m5/link1.dae"
    visual_xyz="0 0 -0.132" visual_rpy="0 0 0"
    sx="0.06" sy="0.06" sz="0.10" ox="0" oy="0" oz="0.05" mass="0.45"/>
  <xacro:mesh_visual_box_collision_link
    name="link2"
    mesh="package://mycobot_description/urdf/mecharm_270_m5/link2.dae"
    visual_xyz="-0.005 0.21 0.002" visual_rpy="1.5708 -3.1415926 0"
    sx="0.04" sy="0.16" sz="0.04" ox="0" oy="-0.08" oz="0" mass="0.35"/>
  <xacro:mesh_visual_box_collision_link
    name="link3"
    mesh="package://mycobot_description/urdf/mecharm_270_m5/link3.dae"
    visual_xyz="-0.09 0.306 0.005" visual_rpy="1.5708 3.1415926 0"
    sx="0.13" sy="0.04" sz="0.04" ox="0.065" oy="0" oz="0" mass="0.30"/>
  <xacro:mesh_visual_box_collision_link
    name="link4"
    mesh="package://mycobot_description/urdf/mecharm_270_m5/link4.dae"
    visual_xyz="0.009 -0.311 -0.228" visual_rpy="0 1.5708 1.5708"
    sx="0.11" sy="0.035" sz="0.035" ox="0.055" oy="0" oz="0" mass="0.24"/>
  <xacro:mesh_visual_box_collision_link
    name="link5"
    mesh="package://mycobot_description/urdf/mecharm_270_m5/link5.dae"
    visual_xyz="-0.292 -0.318 -0.007" visual_rpy="1.5708 0 3.1415926"
    sx="0.09" sy="0.03" sz="0.03" ox="0.045" oy="0" oz="0" mass="0.18"/>
  <xacro:mesh_visual_box_collision_link
    name="link6"
    mesh="package://mycobot_description/urdf/mecharm_270_m5/link6.dae"
    visual_xyz="-0.1645 0.0536 -0.211" visual_rpy="0 1.5708 0"
    sx="0.06" sy="0.03" sz="0.03" ox="0.03" oy="0" oz="0" mass="0.12"/>
  <link name="gripper_base">
    <xacro:box_inertial mass="0.08" x="0.055" y="0.025" z="0.025"/>
    <visual>
      <origin xyz="0.0275 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.055 0.025 0.025"/>
      </geometry>
      <material name="gripper_base_black">
        <color rgba="0.10 0.10 0.10 1.0"/>
      </material>
    </visual>
  </link>
  <link name="gripper_finger">
    <xacro:box_inertial mass="0.04" x="0.07" y="0.012" z="0.012"/>
    <visual>
      <origin xyz="0.035 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.012 0.012"/>
      </geometry>
      <material name="gripper_finger_white">
        <color rgba="0.95 0.95 0.95 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="joint1_to_base" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="8.0" lower="-2.792527" upper="2.792527" velocity="1.0"/>
    <dynamics damping="0.4" friction="0.05"/>
  </joint>

  <joint name="joint2_to_joint1" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.10" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="8.0" lower="-1.3089" upper="2.0943" velocity="1.0"/>
    <dynamics damping="0.4" friction="0.05"/>
  </joint>

  <joint name="joint3_to_joint2" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 -0.16 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="8.0" lower="-3.0543" upper="1.1344" velocity="1.0"/>
    <dynamics damping="0.4" friction="0.05"/>
  </joint>

  <joint name="joint4_to_joint3" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.13 0 0" rpy="0 1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="5.0" lower="-2.7052" upper="2.7052" velocity="1.2"/>
    <dynamics damping="0.25" friction="0.04"/>
  </joint>

  <joint name="joint5_to_joint4" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0.11 0 0" rpy="0 -1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="5.0" lower="-2.0071" upper="2.0071" velocity="1.2"/>
    <dynamics damping="0.25" friction="0.04"/>
  </joint>

  <joint name="joint6_to_joint5" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0.09 0 0" rpy="0 1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="4.0" lower="-3.14" upper="3.14" velocity="1.5"/>
    <dynamics damping="0.2" friction="0.03"/>
  </joint>

  <joint name="joint6output_to_gripper_base" type="fixed">
    <parent link="link6"/>
    <child link="gripper_base"/>
    <origin xyz="0.06 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="joint6output_to_gripper_base">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <joint name="gripper_controller" type="revolute">
    <parent link="gripper_base"/>
    <child link="gripper_finger"/>
    <origin xyz="0.055 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="2.0" lower="-0.74" upper="0.15" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <xacro:controlled_joint name="joint1_to_base" lower="-2.792527" upper="2.792527"/>
    <xacro:controlled_joint name="joint2_to_joint1" lower="-1.3089" upper="2.0943"/>
    <xacro:controlled_joint name="joint3_to_joint2" lower="-3.0543" upper="1.1344"/>
    <xacro:controlled_joint name="joint4_to_joint3" lower="-2.7052" upper="2.7052"/>
    <xacro:controlled_joint name="joint5_to_joint4" lower="-2.0071" upper="2.0071"/>
    <xacro:controlled_joint name="joint6_to_joint5" lower="-3.14" upper="3.14"/>
    <xacro:controlled_joint name="gripper_controller" lower="-0.74" upper="0.15"/>
    <joint name="gripper_base_to_gripper_left2"><param name="mimic">gripper_controller</param><param name="multiplier">1</param><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="gripper_left3_to_gripper_left1"><param name="mimic">gripper_controller</param><param name="multiplier">-1</param><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="gripper_base_to_gripper_right3"><param name="mimic">gripper_controller</param><param name="multiplier">-1</param><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="gripper_base_to_gripper_right2"><param name="mimic">gripper_controller</param><param name="multiplier">-1</param><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="gripper_right3_to_gripper_right1"><param name="mimic">gripper_controller</param><param name="multiplier">1</param><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="physical_grasp" filename="libgazebo_ros_vacuum_gripper.so">
      <ros>
        <namespace>/mecharm_grasp</namespace>
        <remapping>switch:=switch</remapping>
        <remapping>grasping:=grasping</remapping>
      </ros>
      <link_name>gripper_base</link_name>
      <max_distance>0.16</max_distance>
      <fixed>ground_plane</fixed>
      <fixed>work_table</fixed>
      <fixed>place_area</fixed>
    </plugin>
  </gazebo>
</robot>
