<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="fixed_pick_world">
    <physics name="contact_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>100</iters><sor>1.3</sor></solver>
        <constraints><cfm>0.0</cfm><erp>0.2</erp><contact_max_correcting_vel>0.1</contact_max_correcting_vel><contact_surface_layer>0.001</contact_surface_layer></constraints>
      </ode>
    </physics>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>30.0</update_rate>
    </plugin>

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="work_table">
      <static>true</static>
      <pose>0.20 0.00 -0.04 0 0 0</pose>
      <link name="table_link">
        <visual name="table_visual">
          <geometry>
            <box>
              <size>0.60 0.45 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
        <collision name="table_collision">
          <geometry>
            <box>
              <size>0.60 0.45 0.04</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="target_object">
      <static>false</static>
      <pose>0.30 0.18 0.031 0 0 0</pose>
      <link name="target_link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00002</ixx>
            <iyy>0.00002</iyy>
            <izz>0.00002</izz>
          </inertia>
        </inertial>
        <visual name="target_visual">
          <geometry>
            <cylinder>
              <radius>0.015</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="target_collision">
          <geometry>
            <cylinder>
              <radius>0.015</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <surface>
            <friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>10</kd><max_vel>0.05</max_vel><min_depth>0.0005</min_depth></ode></contact>
          </surface>
        </collision>
      </link>
    </model>

    <model name="place_area">
      <static>true</static>
      <pose>0.20 -0.12 0.001 0 0 0</pose>
      <link name="place_area_link">
        <visual name="place_area_visual">
          <geometry>
            <box>
              <size>0.10 0.10 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.6 0.2 0.7</ambient>
            <diffuse>0.1 0.6 0.2 0.7</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
